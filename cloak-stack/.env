# Works out of the box for LOCAL use. For a VPS, change the marked lines.

# LOCAL: http://localhost (plain HTTP). VPS: set to your domain (bare, no scheme)
# for automatic HTTPS, e.g. SITE_ADDRESS=browser.example.com
SITE_ADDRESS=http://localhost

# Login for the web view + MCP endpoint. Default below is user "admin" / pass "admin".
# Each $ in the hash is doubled to $$ so docker compose passes it through literally.
# CHANGE FOR VPS — regenerate (then double every $ -> $$) with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=CHANGE_ME_BCRYPT_HASH

# Password for the noVNC view (a second layer under basic-auth). CHANGE FOR VPS.
VNC_PASSWORD=changeme

# Optional: virtual screen size.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# Optional: residential proxy / extra cloakserve flags (matters more than
# fingerprint on aggressive sites — datacenter IPs get blocked on reputation).
# CLOAK_EXTRA_ARGS=--proxy-server=http://user:pass@proxy-host:port
CLOAK_EXTRA_ARGS=
